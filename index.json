  "plugins": [
    {
      "name": "dsh-token-thrift",
      "title": {
        "en": "Token Thrift",
        "zh": "token 节流"
      },
      "description": {
        "en": "Folds oversized tool output (keeping head, tail, and every error line) and collapses byte-identical results, with the original spilled to disk and recoverable by path. -44.9% characters / -48.0% prompt tokens in a controlled A/B. Limits: verified only on DSH 0.2.1-rc.5 · Windows x64 · Web UI; installed from a pinned Git commit (no npm release); not yet tested on macOS or Linux.",
        "zh": "折叠超长工具输出（保留头尾与全部报错行）、折叠逐字相同的重复结果；原文落盘、可按路径读回。受控 A/B 体积 -44.9%、prompt token -48.0%。 限制：仅在 DSH 0.2.1-rc.5 · Windows x64 · Web UI 上验证；安装的是固定 commit 的 Git 检出（未发 npm）；尚未在 macOS / Linux 测试。"
      },
